# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source data — v2에서는 글 작성에 필수 (CLAUDE.md §5)
# .json만 추적, schema 등은 그대로
/source-data/*
!/source-data/*.json

# scripts (일회성 유틸리티 — 빌드/검증에 필수인 것만 추적)
# 디렉토리가 아닌 *내용물*을 제외해야 화이트리스트(!)가 작동함
/scripts/*
!/scripts/generate-article-json.mjs
!/scripts/fix-bracket-chunks.mjs
# v2 — 6층 검증 시스템 (prepush에서 호출, 다른 환경에서도 필수)
!/scripts/verify-doorway.js
!/scripts/verify-uniqueness.js
# 데이터 다운로드 (e약은요 API → tmp/edrug-all.json 캐시)
!/scripts/fetch-edrug.mjs

# tmp (임시 파일)
/tmp/

# 빌드 시 자동 생성되는 JSON 데이터
/public/data/

# 스크린샷 / 이미지 캡처
*.png
*.jpeg

# 루트 임시 스크립트
/add_spokes.js
/gen_spokes.js
/test_run.js
/tmp_*.js
/spoke_data*.json
/nul

# 백업 파일
/data/*.backup.ts
/data/*.old.ts

# IDE / 도구
.vscode/
.playwright-mcp/
# Claude Code 로컬 설정 — 단, 에이전트 정의(.md)는 팀 공유 필요해서 추적
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/*.md
_workspace/
